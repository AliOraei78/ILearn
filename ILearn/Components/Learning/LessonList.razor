<section class="work"><h2>کدوم فصل رو بازی کنیم؟</h2><ul class="chapters">@foreach(var ready in Content.Lessons){var completed=ready.Activities.Count(a=>Progress.Entries.GetValueOrDefault($"csharp/{ready.Id}/{a.Id}")?.Complete==true);<li><button @onclick="()=>Selected.InvokeAsync(ready)"><strong>@ready.Id · @ready.Title</strong><span class="muted">@(completed==ready.Activities.Count?"تکمیل‌شده":Progress.HasStarted(ready.Id)?"ادامه فصل":"شروع فصل") · @completed از @ready.Activities.Count چالش</span></button></li>}</ul><details><summary>فصل‌های بعدی، هنوز آماده نشده</summary><ul>@foreach(var line in Content.Catalog.Where(line=>!Content.Lessons.Any(l=>line.StartsWith(l.Id+" ")))){<li>@line</li>}</ul></details></section>
@code { [Parameter,EditorRequired] public ICurriculum Content {get;set;}=null!; [Parameter,EditorRequired] public Progress Progress {get;set;}=null!; [Parameter] public EventCallback<Lesson> Selected {get;set;} }
