 <section class="work" aria-labelledby="activity-title" >
 <p class="muted">چالش @(Position+1) از @Count · @Activity.Xp امتیاز تجربه · @(Activity.IsAi?"بررسی اختیاری با هوش مصنوعی":"بررسی با پاسخ‌نامهٔ درس")</p>
 <h2 id="activity-title" tabindex="-1" @ref="title">@Activity.Title</h2><p>@Activity.Prompt</p>
 <button aria-expanded="@(AnswerOpen?"true":"false")" aria-controls="reference-answer" @onclick="Answer">@(AnswerOpen?"بستن پاسخ کامل":"پاسخ کامل")</button>
 @if(AnswerOpen){<aside id="reference-answer" class="feedback"><h3>پاسخ مرجع درس</h3><p>@Activity.Solution</p>@if(Activity.SolutionCode.Length>0){<pre tabindex="0">@Activity.SolutionCode</pre>}<p role="status">@AnswerText</p>@if(Explaining){<button @onclick="Cancel">لغو توضیح مدل</button>}else if(!HasModelAnswer){<button disabled="@Busy" @onclick="Explain">توضیح ساده‌تر با هوش مصنوعی</button>}</aside>}
 @if(!string.IsNullOrWhiteSpace(Activity.Code)){<pre tabindex="0">@Activity.Code</pre>}
@ChildContent
</section>

@code {
 ElementReference title;
 protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender)await title.FocusAsync();}
 [Parameter,EditorRequired] public Activity Activity {get;set;}=null!;
 [Parameter] public int Count {get;set;}
 [Parameter] public int Position {get;set;}
 [Parameter] public bool Busy {get;set;}
 [Parameter] public bool Explaining {get;set;}
 [Parameter] public bool AnswerOpen {get;set;}
 [Parameter] public string AnswerText {get;set;}="";
 [Parameter] public EventCallback Answer {get;set;}
 [Parameter] public EventCallback Explain {get;set;}
 [Parameter] public bool HasModelAnswer {get;set;}
 [Parameter] public EventCallback Cancel {get;set;}
 [Parameter] public RenderFragment? ChildContent {get;set;}
}
