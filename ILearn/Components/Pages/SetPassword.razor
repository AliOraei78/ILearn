@page "/set-password"
@inject IEmailVerification Verification
<PageTitle>تعیین رمز | ILearn</PageTitle>
<header><Brand /><h1>رمز حسابت رو بساز</h1></header>
<main class="work account-panel">
@if(error is not null){<p role="alert" class="feedback error">@error</p>}
@if(valid){<p>ایمیلت تأیید شد. تا ۱۰ دقیقه فرصت داری رمز رو تعیین کنی. این فرصت فقط یک بار استفاده می‌شه.</p><form method="post" action="/auth/password" data-enhance="false"><AntiforgeryToken />
<label for="set-password">رمز تازه</label><input id="set-password" type="password" name="password" required minlength="6" maxlength="256" autocomplete="new-password" /><p class="muted">۶ تا ۱۲۸ نویسه، با حداقل یک حرف، یک عدد و یک نماد.</p>
<label for="set-confirmation">تکرار رمز تازه</label><input id="set-confirmation" type="password" name="confirmation" required minlength="6" maxlength="256" autocomplete="new-password" /><button class="primary">ذخیره رمز</button></form>}
else{<p>فرصت تعیین رمز معتبر نیست یا تموم شده. دوباره ایمیلت رو تأیید کن.</p><a class="account-action" href="/forgot-password"><PixelIcon Kind="key" /><span>درخواست کد تازه</span></a>}
</main><footer>اگر این حساب از قبل رمز داشته، بعد از تغییر رمز باید دوباره واردش بشی.</footer>
@code{
 [CascadingParameter]public HttpContext Context{get;set;}=null!;
 [SupplyParameterFromQuery(Name="message")]public string? Detail{get;set;}
 [SupplyParameterFromQuery(Name="error")]public string? Error{get;set;}
 bool valid;string? error;
 protected override async Task OnInitializedAsync(){error=Detail??(Error switch{"database"=>"ذخیره انجام نشد؛ اتصال رو بررسی کن و دوباره امتحان کن.","expired"=>"فرصت تعیین رمز تموم شده یا قبلاً استفاده شده.",_=>null});try{valid=await Verification.HasGrant(Context.Request.Cookies["ILearn.PasswordGrant"]??"");}catch{error="خواندن مجوز انجام نشد؛ دوباره امتحان کن.";}}
}
