@page "/code-room"
@using ILearn.Components.Learning
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@inject ICurriculum Content
@inject PlayerStore Store
@inject IReviewer Reviewer
@inject NavigationManager Navigation
@inject ILogger<CodeRoom> Logger
<PageTitle>کُد روم | ILearn</PageTitle>
<GameShell Player="@(sessionExpired ? null : player)" Xp="@Xp">
<NavigationLock OnBeforeInternalNavigation="BeforeInternalNavigation" ConfirmExternalNavigation="@(stateVersion != savedVersion)" />
<header class="code-room-header">
 <h1>کُد روم</h1>
 <p class="muted">تمرین عملی فصل‌ها؛ مسئله را بخوان، پاسخ را بنویس و بازخورد بگیر.</p>
</header>
<main class="code-room-main">
 @if(error is not null){
  <div class="feedback error" role="alert" tabindex="-1" @ref="errorNotice">
   <p>@error</p>
   @if(sessionExpired){<a class="button-link" href="@LoginUrl" data-enhance-nav="false">ورود دوباره به حساب</a>}
   else if(progress is null){<button @onclick="Reload">تلاش دوباره برای بارگذاری</button>}
   else{<button @onclick="()=>Save()">تلاش دوباره برای ذخیره</button>}
  </div>
 }
 @if(progress is null){<p role="status">@(error is null ? "در حال خواندن تمرین‌ها…" : "بارگذاری متوقف شد؛ اطلاعات قبلی محفوظ است.")</p>}
 else {
  <div class="code-room-filters">
   <div><label for="code-subject">موضوع</label><select id="code-subject" dir="ltr" value="@subject" @onchange="ChangeSubject">
    @foreach(var group in Content.CodeExercises.GroupBy(item=>item.Subject)){<option value="@group.Key">@group.First().Technology</option>}
   </select></div>
   <div><label for="code-chapter">فصل</label><select id="code-chapter" value="@chapter" @onchange="ChangeChapter">
    <option value="">همه فصل‌ها</option>
    @foreach(var group in SubjectExercises.GroupBy(item=>item.LessonId).OrderBy(group=>group.Key)){<option value="@group.Key">@group.Key · @group.First().LessonTitle</option>}
   </select></div>
   <div><label for="code-template">قالب تمرین</label><select id="code-template" value="@template" @onchange="ChangeTemplate">
    <option value="">همه قالب‌ها</option>
    @foreach(var format in CodeRoomTemplates.All){<option value="@format.Id">@format.Title</option>}
   </select></div>
  </div>
  <p class="muted" role="status">@filtered.Count تمرین با این فیلترها · @filtered.Count(item=>progress.Entries.GetValueOrDefault(item.Key)?.Complete==true) تکمیل‌شده</p>
  @if(exercise is null){
   <section class="work"><h2>تمرینی با این فیلترها پیدا نشد</h2><p>فصل یا قالب دیگری انتخاب کن.</p><button @onclick="ClearFilters">نمایش همه تمرین‌های این موضوع</button></section>
  }
  else {
   <div class="code-exercise-picker"><label for="code-exercise">انتخاب تمرین</label><select id="code-exercise" value="@exercise.Key" @onchange="ChangeExercise" aria-describedby="selected-code-exercise">
    @foreach(var item in filtered){<option value="@item.Key">@item.LessonId · @item.Activity.Title @(progress.Entries.GetValueOrDefault(item.Key)?.Complete==true ? "✓" : "")</option>}
   </select><p id="selected-code-exercise" class="selected-option">تمرین انتخاب‌شده: @exercise.Activity.Title</p></div>
   <div class="code-room-workspace" @key="exercise.Key">
    <section class="work" aria-labelledby="code-problem-title">
     <p class="code-room-meta"><span>@Format!.Title</span><bdi>@exercise.Technology</bdi><span>@exercise.Xp امتیاز تجربه</span></p>
     <h2 id="code-problem-title">@exercise.Activity.Title</h2>
     <p class="muted"><bdi>@exercise.LessonId</bdi> · @exercise.LessonTitle</p>
     <p class="muted">@Format.Description</p>
     <p class="code-room-question">@exercise.Activity.Prompt</p>
     @if(!string.IsNullOrWhiteSpace(exercise.Activity.Code)){<pre class="code-room-source" tabindex="0"><code>@exercise.Activity.Code</code></pre>}
     @if(!string.IsNullOrWhiteSpace(exercise.Activity.Hint)){<details><summary>راهنمایی</summary><p>@exercise.Activity.Hint</p></details>}
     <details><summary>معیار بررسی این تمرین</summary><p class="summary">@(entry!.Feedback.Length>0 ? exercise.Activity.Explanation : "پاسخ باید نیازمندی‌ها و حالت‌های مرزی صورت مسئله را رعایت کند. معیار دقیق، چون شامل پاسخ است، پس از ثبت برای بررسی نمایش داده می‌شود.")</p></details>
     @if(exercise.Subject=="csharp"){<a class="button-link" href="@("/lobby?lesson="+Uri.EscapeDataString(exercise.LessonId))">آموزش این فصل</a>}
    </section>
    <section class="work" aria-labelledby="code-answer-title" aria-busy="@(busy ? "true" : "false")">
     <h2 id="code-answer-title">پاسخ و بازخورد</h2>
     @if(exercise.Template is "repair" or "optimize" && !string.IsNullOrWhiteSpace(exercise.Activity.Code)){
      <div class="toolbar"><button disabled="@(busy||sessionExpired||entry!.Draft.Length>0)" @onclick="UseStarter">شروع از کد مسئله</button></div>
     }
     <CodeAnswerEditor Value="@entry!.Draft" Technology="@exercise.Technology" CodeAnswer="@Format.CodeAnswer" ReadOnly="@sessionExpired" Changed="DraftChanged" />
     <div class="toolbar">
      <button class="primary" disabled="@(busy||sessionExpired||string.IsNullOrWhiteSpace(entry.Draft))" @onclick="AskAi">بررسی پاسخ با هوش مصنوعی</button>
      @if(busy){<button @onclick="CancelReview">لغو بررسی</button><span role="status">در حال بررسی…</span>}
     </div>
     @if(!string.IsNullOrWhiteSpace(entry.Feedback)){<div class="@(entry.FeedbackError ? "feedback error" : "feedback")" role="status">@entry.Feedback</div>}
     @if(entry.Complete){<p class="muted">امتیاز تکمیل این تمرین ثبت شده است؛ بررسی دوباره XP اضافه نمی‌کند.</p>}
     <p class="muted" role="status">@saveStatus</p>
    </section>
   </div>
  }
 }
</main>
<footer>داوری بر اساس معیار همان تمرین است. هوش مصنوعی ممکن است اشتباه کند؛ نتیجه، گزارش اجرای واقعی کد نیست.</footer>
</GameShell>
