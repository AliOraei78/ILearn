@using ILearn.Components.Learning
@page "/lobby"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject ICurriculum Content
@inject PlayerStore Store
@inject IReviewer Reviewer
<PageTitle>ILearn | کارگاه C#</PageTitle>
@if(player is not null && progress is not null){<PlayerBar Player="@player" Xp="@Xp" />}
<header>
 <Brand />
 <h1>لابی بازی</h1>
 <p class="muted">یک مسئله، یک کشف، یک قدم جلوتر.</p>
 @if (progress is not null) {
 <div class="toolbar">@if(screen>0){<button @onclick="()=>Lobby(0)">بازگشت به لابی</button>}<button @onclick="OpenReview">مرور اشتباه‌ها (@ReviewCount)</button></div>
 <p role="status" class="muted">@saveStatus</p>
 }
</header>
<main>
 @if(error is not null){<p class="feedback error" role="alert">@error</p>}
 @if(progress is null){<p role="status">@(error is null?"در حال خواندن محتوای کارگاه…":"بارگذاری متوقف شد؛ اطلاعات قبلی بازنویسی نشده است.")</p>}
 else {
 @if(screen==0){<SubjectList Selected="()=>screen=1" />}
 else if(screen==1){<LessonList Content="Content" Selected="SelectLesson" />}
 else if(showIntro) {
 <LessonIntroduction Lesson="lesson" Started="progress.HasStarted(lesson.Id)" Start="StartChallenges" />
 } else {
 <button @onclick="ShowIntroduction">مرور پیش‌نیازها</button>
 <nav aria-label="چالش‌های جلسه">@for(int i=0;i<lesson.Activities.Count;i++){var n=i;var a=lesson.Activities[i];<button aria-current="@(position==i?"true":"false")" @onclick="()=>Navigate(n)">@(i+1). @a.Title @(GetEntry(a).Complete?"✓":"")</button>}</nav>
 <ActivityWorkspace @key="Key" Activity="activity" Position="position" Busy="busy" AnswerOpen="answerOpen" AnswerText="@answerText" Answer="FullAnswer" Cancel="CancelReview">
 @if(activity.IsAi) {
 <WrittenActivity Activity="activity" Entry="entry" Busy="busy" Changed="DraftChanged" Review="AskAi" Complete="SelfComplete" Cancel="CancelReview" />
 } else if(activity.Kind=="slots") {
 <SlotActivity Activity="activity" Value="SlotValue" Changed="x=>SetSlot(x.Row,x.Value)" />
 } else if(activity.Kind=="order") {
 <OrderingActivity Activity="activity" Order="order" Moved="x=>Move(x.Row,x.Delta)" />
 } else if(activity.Kind=="trace") {
 <TraceActivity Activity="activity" Step="step" StepChanged="x=>step=x" Value="@SlotValue(step)" Selected="x=>SetSlot(step,x)" />
 } else {
 @if(activity.Kind=="detective"){<DetectiveActivity Activity="activity" Clues="clues" Opened="x=>clues.Add(x)" />}
 <ChoiceActivity Activity="activity" Entry="entry" Selected="Toggle" />
 }
 @if(!activity.IsAi){<div class="toolbar"><button class="primary" @onclick="Check">ثبت جواب</button><button @onclick="()=>hint=!hint">@(hint?"بستن راهنمایی":"یک راهنمایی")</button></div>}
 @if(hint){<p class="feedback">@activity.Hint</p>}
 @if(!string.IsNullOrWhiteSpace(entry.Feedback)){<div class="feedback" role="status">@entry.Feedback</div>}
 @if(entry.Complete){<p class="muted">تکمیل ثبت شد: @entry.Source · تکرار این چالش XP اضافه نمی‌کند.</p>}
 </ActivityWorkspace>
 <div class="toolbar" style="margin-top:16px"><button disabled="@(position==0)" @onclick="()=>Navigate(position-1)">چالش قبل</button><button disabled="@(position==7)" @onclick="()=>Navigate(position+1)">چالش بعد</button><span class="muted" role="status">@saveStatus</span></div>
 }
 }
</main>
<footer>محلی و شخصی · بدون زمان‌سنج · انتخاب ترتیب چالش‌ها آزاد است.</footer>
