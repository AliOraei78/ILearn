@page "/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject PlayerStore Store
<PageTitle>پروفایل من | ILearn</PageTitle>
@if(player is not null){<PlayerBar Player="@player" Xp="@xp" />}
<header><h1>پروفایل من</h1><a class="account-action compact" href="/lobby"><PixelIcon Kind="back" /><span>بازگشت به لابی</span></a></header>
<main>
@if(error is not null){<p role="alert" class="feedback error">@error</p>}
@if(player is null){<p role="status">داریم پروفایلت رو می‌خونیم…</p>}
else {
 <section class="work"><h2>نام و رمز عبور</h2>
 @if(Saved){<p class="feedback" role="status">مشخصاتت ذخیره شد.</p>}
 @if(Detail is not null || AccountError is not null){<p class="feedback error" role="alert">@(Detail??"ذخیره انجام نشد؛ اتصال رو بررسی کن و دوباره امتحان کن.")</p>}
 <form method="post" action="/auth/profile" data-enhance="false"><AntiforgeryToken />
 <label for="profile-name">نام بازیکن</label><input id="profile-name" name="name" value="@player.Name" required maxlength="50" autocomplete="nickname" />
 <label for="current-password">رمز فعلی</label><input id="current-password" name="currentPassword" type="password" required maxlength="256" autocomplete="current-password" />
 <label for="new-password">رمز تازه (اگر نمی‌خوای عوض بشه خالی بذار)</label><input id="new-password" name="newPassword" type="password" minlength="6" maxlength="256" autocomplete="new-password" /><p class="muted">رمز تازه باید ۶ تا ۱۲۸ نویسه و شامل حرف، عدد و نماد باشه.</p>
 <label for="new-password-confirmation">تکرار رمز تازه</label><input id="new-password-confirmation" name="confirmation" type="password" minlength="6" maxlength="256" autocomplete="new-password" />
 <button class="primary">ذخیره مشخصات</button></form></section>
 <h2>کاراکترت رو انتخاب کن</h2><p role="status">@status</p><div class="avatar-grid">@for(int i=1;i<=48;i++){var id=$"avatar-{i:00}";<button aria-label="@($"کاراکتر {i}")" aria-pressed="@(player.Avatar==id)" @onclick="()=>Choose(id)"><Avatar Id="@id" /></button>}</div>}
</main><footer>انتخاب کاراکتر روی پیشرفتت اثری نداره.</footer>
@code {
 Player? player; string? error; string status="";int xp;
 [SupplyParameterFromQuery(Name="saved")] public bool Saved {get;set;}
 [SupplyParameterFromQuery(Name="message")] public string? Detail {get;set;}
 [SupplyParameterFromQuery(Name="error")] public string? AccountError {get;set;}
 [Inject] public ICurriculum Content {get;set;}=null!;
 protected override async Task OnInitializedAsync(){try{player=await Store.Profile();var progress=await Store.Load();xp=LearningService.Xp(Content.Lessons,progress);}catch{error="پروفایل باز نشد. اتصال دیتابیس رو بررسی کن.";}}
 async Task Choose(string id){try{await Store.Avatar(id);player=player! with {Avatar=id};status="کاراکترت ذخیره شد.";}catch{error="ذخیره نشد؛ دوباره امتحان کن.";}}
}
