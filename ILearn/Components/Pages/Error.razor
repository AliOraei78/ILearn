@page "/Error"
@using System.Diagnostics

<PageTitle>خطای برنامه | ILearn</PageTitle>
<header><Brand /><h1>درخواست انجام نشد</h1></header>
<main class="work account-panel">
    <p role="alert">برنامه نتوانست این درخواست را کامل کند. کمی بعد دوباره تلاش کن.</p>
    <p>اگر در صفحهٔ دیگری پاسخ ذخیره‌نشده داری، پیش از بارگذاری دوباره یک نسخه از آن نگه دار.</p>
    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p class="muted">شناسهٔ پیگیری: <bdi>@RequestId</bdi></p>
    }
    <a class="button-link" href="/lobby">بازگشت به لابی</a>
</main>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = System.Diagnostics.Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
