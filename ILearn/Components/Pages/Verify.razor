@page "/verify"
@using Microsoft.AspNetCore.DataProtection
@inject IDataProtectionProvider Protection
@inject IEmailVerification Verification
<PageTitle>تأیید ایمیل | ILearn</PageTitle>
<header><Brand /><h1>ایمیلت رو تأیید کن</h1></header>
<main class="work account-panel">
@if(email is null){<p>اول اطلاعات حساب رو وارد کن.</p><a class="button-link" href="/register" data-enhance-nav="false">ساخت حساب کاربری</a>}
else{
 <p>کد شش‌رقمی رو در ایمیلت پیدا کن و اینجا بنویس. پوشهٔ هرزنامه رو هم نگاه کن. کد دو دقیقه معتبره.</p>
 <p><bdi>@email</bdi></p>
 @if(message is not null){<p role="alert" class="feedback error">@message</p>}
 <form method="post" action="/auth/verify" data-enhance="false"><AntiforgeryToken />
 <label for="code">کد تأیید ایمیل</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9۰-۹٠-٩]{6}" minlength="6" maxlength="6" required dir="ltr" />
 <button class="primary">تأیید ایمیل و ادامه</button></form>
 <form method="post" action="/auth/resend" data-enhance="false"><AntiforgeryToken /><button disabled="@(remaining>0)" data-resend-seconds="@remaining">ارسال دوباره (@remaining ثانیه)</button></form>
 <p><a class="button-link" href="@(Context.Request.Cookies["ILearn.VerificationFlow"]=="recovery"?"/forgot-password":"/register")" data-enhance-nav="false">تغییر ایمیل</a></p>
}
</main><footer>بعد از تأیید ایمیل، رمز حسابت رو تعیین می‌کنی.</footer>
@code{
 [CascadingParameter] public HttpContext Context {get;set;}=null!;
 [SupplyParameterFromQuery(Name="error")] public string? Error {get;set;}
 [SupplyParameterFromQuery(Name="message")] public string? Detail {get;set;}
 [SupplyParameterFromQuery(Name="wait")] public int? Wait {get;set;}
 string? email,message;int remaining;
 protected override async Task OnInitializedAsync(){email=AccountEndpoints.Pending(Context,Protection);message=Detail??(Error switch{"delivery"=>"ارسال ایمیل تأیید نشد. اگر کد رسید واردش کن؛ برای ارسال دوباره کمی صبر کن.","code"=>"کد درست نیست، منقضی شده یا تعداد تلاش‌ها پر شده. کد تازه درخواست کن.","database"=>"اتصال به دیتابیس برقرار نشد. دوباره امتحان کن.",_=>null});if(email is not null){try{remaining=Math.Max(await Verification.Remaining(email),Math.Clamp(Wait??0,0,3600));}catch{message="خواندن زمان ارسال دوباره انجام نشد؛ صفحه رو دوباره باز کن.";remaining=120;}}}
}
