<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="brand.svg" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["interaction.css"]" />
    <link rel="stylesheet" href="@Assets["ILearn.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["textarea.js"]" defer></script>
    <script src="@Assets["avatars.js"]" defer></script>
    <script src="@Assets["verification.js"]" defer></script>
</body>

</html>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = null!;
    // Keep game navigation in one interactive router so NavigationLock also guards links and browser history.
    IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
