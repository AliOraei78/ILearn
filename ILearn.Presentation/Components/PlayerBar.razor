@inject LearningUiOptions Experience
@if(Experience.LocalProfile){<p class="offline-note">پروفایل و سیو محلی · هوش مصنوعی با اینترنت</p>}
<section class="player-bar" aria-label="اطلاعات بازیکن">
 <div class="player-bar-inner">
  <div class="player-bar-character"><Avatar Id="@Player.Avatar" /></div>
  <div class="player-bar-identity">
   <strong>@Player.Name</strong>
   <span><bdi>Level @Levels.Number(Xp)</bdi> · @Levels.Title(Xp)</span>
  </div>
  <div class="player-bar-progress">
   <label for="player-level-progress">@(Xp<200?$"تا لقب بعدی: {Xp} از ۲۰۰ امتیاز تجربه":$"لقب کدآموز دریافت شد · {Xp} امتیاز تجربه")</label>
   <progress id="player-level-progress" value="@Math.Min(Xp,200)" max="200"></progress>
  </div>
  <div class="player-bar-actions">
   <Brand />
   <a class="button-link profile-link" href="/profile"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M6 2h8v8H6zM4 12h12v2h2v4H2v-4h2z" /></svg>پروفایل من</a>
   @if(!Experience.LocalProfile){<form method="post" action="/auth/logout" data-enhance="false"><AntiforgeryToken /><button>خروج</button></form>}
  </div>
 </div>
</section>
@code {
 [Parameter, EditorRequired] public Player Player { get; set; } = null!;
 [Parameter] public int Xp { get; set; }
}
