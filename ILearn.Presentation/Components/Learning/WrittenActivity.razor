@inject LearningUiOptions Experience
 <label for="draft">@(Activity.Kind=="workshop"?"کد تو (اجرا نمی‌شود)":"پاسخ تو")</label>
 <textarea id="draft" readonly="@ReadOnly" aria-describedby="@(Activity.Kind=="workshop"&&!ReadOnly?"keyboard-help":null)" class="@(Activity.Kind=="workshop"?"code":"")" dir="@(Activity.Kind=="workshop"?"ltr":"rtl")" spellcheck="false" maxlength="16000" value="@Entry.Draft" @oninput="Changed"></textarea>
 @if(Activity.Kind=="workshop"&&!ReadOnly){<p id="keyboard-help" class="muted">Tab: چهار فاصله؛ Shift+Tab: کاهش تورفتگی؛ برای خروج از کادر Escape و سپس Tab را بزن.</p>}
 <p class="muted">پاسخ فقط با صورت همین مرحله سنجیده می‌شود. مدل ممکن است اشتباه کند؛ پاسخ مرجع برای خودارزیابی آماده است.</p>
 @if(Experience.LocalProfile){<p class="muted">بررسی AI به اینترنت و کلید نیاز دارد. <a href="/profile#ai-settings">تنظیمات هوش مصنوعی</a></p>}
 <details><summary>معیار ثابت بررسی این تمرین</summary><p><LearningText Text="@(Entry.Feedback.Length>0 ? Activity.Explanation : "پاسخ باید تمام نیازمندی‌های صورت مسئله را پوشش بدهد. معیار دقیق، چون شامل پاسخ است، پس از ثبت پاسخ نمایش داده می‌شود.")" Inline="true" /></p></details>
 <div class="toolbar"><button class="primary" disabled="@(Busy||ReadOnly||string.IsNullOrWhiteSpace(Entry.Draft))" @onclick="Review">بررسی پاسخ با هوش مصنوعی</button><button disabled="@(ReadOnly||string.IsNullOrWhiteSpace(Entry.Draft))" @onclick="Complete">ثبت شخصی تکمیل</button>@if(Busy){<button @onclick="Cancel">لغو بررسی</button><span role="status">در حال بررسی…</span>}</div>
@code { [Parameter,EditorRequired] public Activity Activity {get;set;}=null!; [Parameter,EditorRequired] public Entry Entry {get;set;}=null!; [Parameter] public bool Busy {get;set;} [Parameter] public bool ReadOnly {get;set;} [Parameter] public EventCallback<ChangeEventArgs> Changed {get;set;} [Parameter] public EventCallback Review {get;set;} [Parameter] public EventCallback Complete {get;set;} [Parameter] public EventCallback Cancel {get;set;} }
