
@for(int i=0;i<Activity.Rows.Length;i++)
{
    var row=i;
    var selected=Value(i);
    var hasSelection=int.TryParse(selected,out var index)&&index>=0&&index<Activity.Options.Length;
    <div class="slot">
        <label for="@($"slot-{i}")">@Activity.Rows[i]</label>
        <select id="@($"slot-{i}")" value="@selected" aria-describedby="@(hasSelection?$"slot-value-{i}":null)" @onchange="e=>Changed.InvokeAsync((row,e.Value?.ToString()??string.Empty))">
            <option value="">انتخاب کن</option>
            @for(int j=0;j<Activity.Options.Length;j++){<option value="@j">@Activity.Options[j]</option>}
        </select>
        @if(hasSelection){<p id="@($"slot-value-{i}")" class="selected-option muted">گزینهٔ انتخابی: <LearningText Text="@Activity.Options[index]" Inline="true" /></p>}
    </div>
}

@code {[Parameter,EditorRequired] public Activity Activity {get;set;}=null!;[Parameter,EditorRequired] public Func<int,string> Value {get;set;}=null!; [Parameter] public EventCallback<(int Row,string Value)> Changed {get;set;}}
